# Never ship secrets in the image. (The image copies only backend/ and
# registry/, so root-level working files never enter it regardless.)
.env
.env.*
!.env.example

# Not needed in the backend image.
.git/
.github/
frontend/
benchmark/
backend/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
registry/__pycache__/
