# Copy this file to .env and fill in values. Never commit .env.
# Every secret in this project is supplied through the environment only.

# Application environment: dev | prod
APP_ENV=dev

# Comma-separated list of origins allowed to call the backend.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Anthropic API key. Used only by Mode 2 answer generation (task 4.2).
# Leave blank until that task; the backend starts fine without it.
ANTHROPIC_API_KEY=

# Hugging Face token for the AI-text detection model (task 2.1).
# Leave blank until that task; the backend starts fine without it.
HF_API_TOKEN=

# Pinned Anthropic model id for Mode 2 answers; override only with intent.
ANTHROPIC_MODEL=claude-sonnet-5
