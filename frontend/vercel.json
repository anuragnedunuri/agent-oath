{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://agent-oath.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://agent-oath.onrender.com/health"
    },
    {
      "source": "/demo/:path*",
      "destination": "https://agent-oath.onrender.com/demo/:path*"
    }
  ]
}
